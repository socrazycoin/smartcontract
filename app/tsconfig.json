{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "lib": ["es2020"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "../dist/app",
    "rootDir": "..",
    "typeRoots": ["../node_modules/@types"]
  },
  "include": ["./**/*.ts", "../target/types/**/*.ts"],
  "exclude": ["node_modules"]
}
