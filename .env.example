# ICO Contract Deployment
# Copy this to .env and fill in values for the target network

# Path to the deployer/admin keypair JSON file
ADMIN_KEYPAIR=~/.config/solana/id.json

# Solana RPC URL (localnet | devnet | mainnet-beta or custom URL)
CLUSTER_URL=https://api.devnet.solana.com

# Token mint address (created before deployment)
TOKEN_MINT=

# Program ID (auto-detected from target/deploy/contract-keypair.json if empty)
PROGRAM_ID=
